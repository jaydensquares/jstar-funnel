# Required — comps + valuation (https://app.rentcast.io/app/api)
RENTCAST_API_KEY=

# Where the deal sheet goes (pick one or both)
LEAD_WEBHOOK_URL=          # GoHighLevel / Zapier / Make / Google Sheets webhook
RESEND_API_KEY=            # https://resend.com
NOTIFY_EMAIL=you@example.com
NOTIFY_FROM=Leads <leads@yourdomain.com>

# Meta Conversions API (server-side Lead event — improves ad optimization)
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=      # only while testing in Events Manager

# Text alert to your phone (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+12145550100
NOTIFY_SMS_TO=+12145550123

# Phone alert via the free ntfy app (no carrier registration needed).
# Pick a long random topic name nobody could guess, and subscribe to it in the app.
NTFY_TOPIC=
