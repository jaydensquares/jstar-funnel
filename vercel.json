{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/f/:slug",
      "destination": "/api/funnel?slug=:slug"
    },
    {
      "source": "/f/:slug/:page(privacy|terms)",
      "destination": "/api/funnel?slug=:slug&page=:page"
    },
    {
      "source": "/d/:t/:img",
      "destination": "/api/dealpage?t=:t&img=:img"
    },
    {
      "source": "/d/:t",
      "destination": "/api/dealpage?t=:t"
    }
  ],
  "functions": {
    "api/funnel.js": {
      "includeFiles": "{offer,privacy,terms}.html"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 13 * * *"
    }
  ]
}
